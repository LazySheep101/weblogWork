server:
  port: 8081
spring:
  datasource:
    driver-class-name: com.p6spy.engine.spy.P6SpyDriver
    url: jdbc:p6spy:mysql://127.0.0.1:3307/weblog?useUnicode=true&characterEncoding=UTF-8&autoReconnect=true&zeroDateTimeBehavior=convertToNull
    username: root
    password: your_local_db_password
    hikari:
      minimum-idle: 5
      maximum-pool-size: 20
      auto-commit: true
      idle-timeout: 30000
      pool-name: Weblog-HikariCP
      max-lifetime: 1800000
      connection-timeout: 30000
      connection-test-query: SELECT 1

minio:
  endpoint: http://127.0.0.1:9000
  accessKey: your_minio_access_key
  secretKey: your_minio_secret_key
  bucketName: weblog

lucene:
  indexDir: /path/to/weblog/lucene-index
